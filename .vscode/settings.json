{
    "git.addAICoAuthor": "off",

    // Generated files: change their sources and run the tool instead.
    //   icons/<pack>.yaml      <- icons/semantic.yaml + icons/sources/   (tools/build_icons.py)
    //   fonts/orbita-brand.ttf <- brand/*.svg                            (tools/build_brand_font.py)
    "files.readonlyInclude": {
        "icons/*.yaml": true,
        "fonts/orbita-brand.ttf": true
    },
    "files.readonlyExclude": {
        "icons/semantic.yaml": true
    }
}
